# The coupled COM coefficients and post-solve translation removal are two
# inconsistent frame constraints and must be rejected during initialization.
# Enable if: QUICK_TEST
# EXPECT FAILURE

include $ASPECT_SOURCE_DIR/tests/potential_feedback_center_of_mass.prm

set Output directory = output-potential-feedback-center-of-mass-net-translation

subsection Nullspace removal
  set Remove nullspace = net translation, angular momentum
end
