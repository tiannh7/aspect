# Exercise the coupled degree-one center-of-mass reference frame. The total
# reference mass is defined by M=g(R)R^2/G. This synthetic case chooses
# g(R)=G*(12*pi)/R^2, so the gravity-defined mass is 12*pi kg. The equality
# with the simple density bookkeeping is intentional test construction, not a
# general assumption that the density immediately below the CMB is the mean
# density of the unresolved core.
# Enable if: QUICK_TEST

include $ASPECT_SOURCE_DIR/tests/potential_feedback_default_none.prm

set Output directory = output-potential-feedback-center-of-mass

subsection Gravity model
  subsection Radial constant
    set Magnitude = 6.290379554356307e-10
  end
end

subsection Potential feedback
  subsection Potential iteration
    set Relative tolerance = 1e-2
  end

  subsection Reference frame
    set Degree 1 reference frame = center of mass
  end
end
