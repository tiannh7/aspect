# Exercise the coupled degree-one center-of-mass reference frame. The inherited
# input is the default-off regression, so this override is the only physical
# difference between the two tests.
# Enable if: QUICK_TEST

include $ASPECT_SOURCE_DIR/tests/potential_feedback_default_none.prm

set Output directory = output-potential-feedback-center-of-mass

subsection Nullspace removal
  set Remove nullspace = angular momentum
end

subsection Potential feedback
  subsection Reference frame
    set Degree 1 reference frame = center of mass
  end
end
