# Exercise the matrix-free internal density-jump response on the same
# three-dimensional single-level custom mesh as the assembled diagnostic.
# Enable if: QUICK_TEST
# DEPENDS-ON: density_source_manager_tabulated_radial_piecewise_3d_amg

include $ASPECT_SOURCE_DIR/tests/density_source_manager_tabulated_radial_piecewise_3d_amg.prm

set Output directory = output-density-source-manager-tabulated-radial-piecewise-3d-gmg

subsection Solver parameters
  subsection Stokes solver parameters
    set Stokes GMG type    = local smoothing
    set Stokes solver type = block GMG
  end
end
